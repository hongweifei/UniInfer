/target
**/__pycache__
.venv
models/cache
*.gguf
*.safetensors

/apps/desktop/gen
/apps/desktop/target

# downloaded model artifacts
/models/qwen3-0.6b/*.json
/models/qwen3-0.6b-safetensors/*.json

# ONNX Qwen3 weights/tokenizer; fetch via models/fetch-qwen3-onnx.sh
/models/qwen3-0.6b-onnx/*.onnx
/models/qwen3-0.6b-onnx/*.json
/models/qwen3-0.6b-onnx/onnxruntime/
!/models/qwen3-0.6b-onnx/genai_config.json

# Whisper GGML weights; fetch via models/fetch-whisper.sh
/models/whisper-large-v3-turbo-ggml/*.bin

# ONNX Whisper weights/tokenizer; fetch via models/fetch-onnx-whisper.sh
/models/whisper-tiny.en-onnx/onnx/*.onnx
/models/whisper-tiny.en-onnx/*.json

# Whisper ONNX tokenizer sidecar
/models/whisper-tiny.en-onnx/merges.txt

# Qwen3-VL weights/tokenizer; fetch via models/fetch-qwen3-vl.sh
/models/qwen3-vl-2b/*.safetensors
/models/qwen3-vl-2b/*.json
/models/qwen3-vl-2b/*.txt
!/models/qwen3-vl-2b/manifest.toml

# Qwen2.5-VL GGUF; fetch via models/fetch-qwen2.5-vl-gguf.sh
/models/qwen2.5-vl-7b-gguf/*.gguf
/models/qwen2.5-vl-7b-gguf/*.gguf.*
/models/qwen2.5-vl-7b-gguf/*.json
/models/qwen2.5-vl-7b-gguf/*.md

# SmolVLM2 GGUF; fetch via models/fetch-smolvlm2-256m.sh
/models/smolvlm2-256m-q4/*.gguf
/models/smolvlm2-256m-q4/*.json
!/models/smolvlm2-256m-q4/manifest.toml
